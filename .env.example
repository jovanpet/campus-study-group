# Copy to .env for local development; the Makefile loads it automatically.
# On Heroku these come from config vars (see infra/main.tf); APP_ENV defaults to production.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_study_group?sslmode=disable
LOG_LEVEL=debug

# Required only when APP_ENV=production.
# SESSION_SECRET encrypts stored Apple refresh tokens (32+ characters).
# Without the APPLE_* values, POST /auth/apple returns 503; sign in with
# POST /auth/dev instead (see docs/testing-auth.md).
SESSION_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
