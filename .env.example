# Copy to .env for local development; the Makefile loads it automatically.
# On Heroku these come from config vars (see infra/main.tf); APP_ENV defaults to production.
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campus_study_group?sslmode=disable
LOG_LEVEL=debug

# Required only when APP_ENV=production
SESSION_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
